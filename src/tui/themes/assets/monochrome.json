{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background100": "#0A0A0A",
    "background200": "#000000",
    "gray100": "#1A1A1A",
    "gray200": "#1F1F1F",
    "gray300": "#292929",
    "gray400": "#2E2E2E",
    "gray500": "#454545",
    "gray600": "#878787",
    "gray700": "#8F8F8F",
    "gray900": "#A1A1A1",
    "gray1000": "#EDEDED",
    "statusSuccessDark": "#5F7A64",
    "statusInfoDark": "#5F6E7A",
    "statusWarningDark": "#7A6F5F",
    "statusErrorDark": "#7A5F62",
    "statusSuccessLight": "#1E2B21",
    "statusInfoLight": "#1E262B",
    "statusWarningLight": "#2B261E",
    "statusErrorLight": "#2B1E20",
    "lightBackground": "#FFFFFF",
    "lightGray100": "#FAFAFA",
    "lightGray200": "#EAEAEA",
    "lightGray600": "#666666",
    "lightGray1000": "#171717"
  },
  "theme": {
    "primary": {
      "dark": "gray1000",
      "light": "lightGray1000"
    },
    "secondary": {
      "dark": "gray900",
      "light": "lightGray600"
    },
    "accent": {
      "dark": "gray700",
      "light": "lightGray1000"
    },
    "error": {
      "dark": "statusErrorDark",
      "light": "statusErrorLight"
    },
    "warning": {
      "dark": "statusWarningDark",
      "light": "statusWarningLight"
    },
    "success": {
      "dark": "statusSuccessDark",
      "light": "statusSuccessLight"
    },
    "info": {
      "dark": "statusInfoDark",
      "light": "statusInfoLight"
    },
    "text": {
      "dark": "gray1000",
      "light": "lightGray1000"
    },
    "textMuted": {
      "dark": "gray600",
      "light": "lightGray600"
    },
    "background": {
      "dark": "background200",
      "light": "lightBackground"
    },
    "backgroundPanel": {
      "dark": "gray100",
      "light": "lightGray100"
    },
    "backgroundElement": {
      "dark": "gray300",
      "light": "lightGray200"
    },
    "border": {
      "dark": "gray300",
      "light": "lightGray200"
    },
    "borderActive": {
      "dark": "gray500",
      "light": "#999999"
    },
    "borderSubtle": {
      "dark": "gray100",
      "light": "#EAEAEA"
    },
    "diffAdded": {
      "dark": "statusSuccessDark",
      "light": "statusSuccessLight"
    },
    "diffRemoved": {
      "dark": "statusErrorDark",
      "light": "statusErrorLight"
    },
    "diffContext": {
      "dark": "gray600",
      "light": "lightGray600"
    },
    "diffHunkHeader": {
      "dark": "gray600",
      "light": "lightGray600"
    },
    "diffHighlightAdded": {
      "dark": "statusSuccessDark",
      "light": "statusSuccessLight"
    },
    "diffHighlightRemoved": {
      "dark": "statusErrorDark",
      "light": "statusErrorLight"
    },
    "diffAddedBg": {
      "dark": "#111413",
      "light": "#E4E4E4"
    },
    "diffRemovedBg": {
      "dark": "#141111",
      "light": "#E4E4E4"
    },
    "diffContextBg": {
      "dark": "background200",
      "light": "lightBackground"
    },
    "diffLineNumber": {
      "dark": "#8a8a8a",
      "light": "textMuted"
    },
    "diffAddedLineNumberBg": {
      "dark": "#151817",
      "light": "#D9D9D9"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#181414",
      "light": "#D9D9D9"
    },
    "markdownText": {
      "dark": "gray1000",
      "light": "lightGray1000"
    },
    "markdownHeading": {
      "dark": "gray1000",
      "light": "lightGray1000"
    },
    "markdownLink": {
      "dark": "gray900",
      "light": "lightGray1000"
    },
    "markdownLinkText": {
      "dark": "gray700",
      "light": "lightGray600"
    },
    "markdownCode": {
      "dark": "gray900",
      "light": "lightGray1000"
    },
    "markdownBlockQuote": {
      "dark": "gray600",
      "light": "lightGray600"
    },
    "markdownEmph": {
      "dark": "gray900",
      "light": "lightGray600"
    },
    "markdownStrong": {
      "dark": "gray1000",
      "light": "lightGray1000"
    },
    "markdownHorizontalRule": {
      "dark": "gray500",
      "light": "#999999"
    },
    "markdownListItem": {
      "dark": "gray1000",
      "light": "lightGray1000"
    },
    "markdownListEnumeration": {
      "dark": "gray900",
      "light": "lightGray600"
    },
    "markdownImage": {
      "dark": "gray900",
      "light": "lightGray600"
    },
    "markdownImageText": {
      "dark": "gray700",
      "light": "lightGray600"
    },
    "markdownCodeBlock": {
      "dark": "gray1000",
      "light": "lightGray1000"
    },
    "syntaxComment": {
      "dark": "gray600",
      "light": "#888888"
    },
    "syntaxKeyword": {
      "dark": "gray900",
      "light": "lightGray600"
    },
    "syntaxFunction": {
      "dark": "gray1000",
      "light": "lightGray1000"
    },
    "syntaxVariable": {
      "dark": "gray1000",
      "light": "lightGray1000"
    },
    "syntaxString": {
      "dark": "gray900",
      "light": "lightGray600"
    },
    "syntaxNumber": {
      "dark": "gray900",
      "light": "lightGray600"
    },
    "syntaxType": {
      "dark": "gray700",
      "light": "lightGray1000"
    },
    "syntaxOperator": {
      "dark": "gray900",
      "light": "lightGray600"
    },
    "syntaxPunctuation": {
      "dark": "gray1000",
      "light": "lightGray1000"
    }
  }
}
