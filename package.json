{
  "name": "picobu",
  "version": "1.22.6",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "env -u BUN_INSPECT -u BUN_INSPECT_NOTIFY -u BUN_INSPECT_CONNECT_TO bun run src/cli.ts",
    "tsc": "tsc -noEmit",
    "test": "AGENT=1 bun test tests",
    "lint": "biome check src tests --max-diagnostics 900",
    "lint:fix": "biome check --write src tests --max-diagnostics 900",
    "format": "biome format --write src tests --max-diagnostics 900",
    "parsers:update": "bun ./scripts/update-tree-sitter-assets.ts",
    "version:bump": "bun ./scripts/bump-version.ts",
    "version:feature": "bun ./scripts/bump-version.ts --feature"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/turndown": "^5.0.6"
  },
  "peerDependencies": {
    "typescript": "^5",
    "solid-js": "1.9.12"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.82",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/azure": "^4.0.70",
    "@ai-sdk/cerebras": "^3.0.48",
    "@ai-sdk/cohere": "^4.0.41",
    "@ai-sdk/deepinfra": "^3.0.48",
    "@ai-sdk/gateway": "^4.0.80",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/google-vertex": "^5.0.81",
    "@ai-sdk/groq": "^4.0.41",
    "@ai-sdk/mcp": "^2.0.44",
    "@ai-sdk/mistral": "^4.0.43",
    "@ai-sdk/open-responses": "^2.0.38",
    "@ai-sdk/openai": "^4.0.58",
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@ai-sdk/perplexity": "^4.0.43",
    "@ai-sdk/provider": "^4.0.10",
    "@ai-sdk/togetherai": "^3.0.49",
    "@ai-sdk/vercel": "^3.0.30",
    "@ai-sdk/xai": "^4.0.58",
    "@opencode-ai/models": "^0.0.65",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@vscode/ripgrep": "^1.18.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "ai": "^7.0.92",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "opentui-spinner": "^0.0.7",
    "pino": "^10.3.1",
    "puppeteer": "^25.10.0",
    "turndown": "^7.2.4",
    "zod": "^4.5.4"
  }
}
